        <h2 class="font-cinzel text-2xl font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-folder-plus text-red-500"></i> Tambah Karakter / Kriptid Baru
        </h2>
        <p class="font-mono text-xs text-gray-400 mt-1">
          Formulir mandiri tanpa perlu koding. Karakter akan langsung tersimpan di browser Anda.
        </p>
      </div>

      <!-- Form Inputs -->
      <form id="addMonsterForm" onsubmit="handleFormSubmit(event)" class="space-y-4 font-mono text-xs">
        <div>
          <label class="block text-gray-400 mb-1">Nama Karakter / Makhluk *</label>
          <input type="text" id="inputName" required placeholder="Contoh: Hantu Bersiul Pegunungan Haruna" 
                 class="w-full px-3 py-2 bg-darkvoid border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-red-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-gray-400 mb-1">Kategori *</label>
            <select id="inputCategory" class="w-full px-3 py-2 bg-darkvoid border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-red-500">
              <option value="Kriptid">Kriptid / UMA</option>
              <option value="Monster">Monster / Entitas</option>
              <option value="Urban Legend">Legenda Perkotaan</option>
              <option value="Lore">Lore & Artefak</option>
            </select>
          </div>
          <div>
            <label class="block text-gray-400 mb-1">Tingkat Bahaya *</label>
            <select id="inputDanger" class="w-full px-3 py-2 bg-darkvoid border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-red-500">
              <option value="EXTREME">EXTREME (Sangat Fatal)</option>
              <option value="HIGH">HIGH (Tinggi)</option>
              <option value="MODERATE">MODERATE (Sedang)</option>
              <option value="LOW">LOW (Rendah)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-gray-400 mb-1">Habitat / Asal *</label>
            <input type="text" id="inputHabitat" required placeholder="Contoh: Hutan Gunung Haruna" 
                   class="w-full px-3 py-2 bg-darkvoid border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-red-500">
          </div>
          <div>
            <label class="block text-gray-400 mb-1">Ukuran / Stats *</label>
            <input type="text" id="inputStats" required placeholder="Contoh: Tinggi 180 cm / Lincah" 
                   class="w-full px-3 py-2 bg-darkvoid border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-red-500">
          </div>
        </div>

        <div>
          <label class="block text-gray-400 mb-1">Ciri Khusus singkat</label>
          <input type="text" id="inputTraits" placeholder="Contoh: Mengeluarkan siulan melengking di malam hari" 
                 class="w-full px-3 py-2 bg-darkvoid border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-red-500">
        </div>

        <div>
          <label class="block text-gray-400 mb-1">URL Gambar Ilustrasi (Opsional)</label>
          <input type="url" id="inputImage" placeholder="https://..." 
                 class="w-full px-3 py-2 bg-darkvoid border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-red-500">
        </div>

        <div>
          <label class="block text-gray-400 mb-1">Deskripsi / Cerita Latar Belakang *</label>
          <textarea id="inputDescription" rows="4" required placeholder="Tuliskan cerita latar belakang, saksi mata, atau lore karakter ini..." 
                    class="w-full px-3 py-2 bg-darkvoid border border-gray-700 rounded text-gray-200 focus:outline-none focus:border-red-500 font-sans text-sm"></textarea>
        </div>

        <div class="pt-3 flex justify-end gap-3">
          <button type="button" onclick="closeAddModal()" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded">Batal</button>
          <button type="submit" class="px-5 py-2 bg-blood-600 hover:bg-blood-500 text-white font-bold rounded border border-red-500 flex items-center gap-2">
            <i class="fa-solid fa-save"></i> Simpan Karakter
          </button>
        </div>
      </form>
    </div>
  </div>


  <!-- JAVASCRIPT LOGIC -->
  <script>
    // INITIAL CREATURE DATA (Default Database)
    const initialCreatures = [
      {
        id: 'rawng',
        name: 'RAWNG (ラウング)',
        category: 'Kriptid',
        habitat: 'Pegunungan Gunma, Jepang',
        stats: 'Tinggi: 215 cm | Kecepatan: 45.57 km/jam',
        traits: '48 gigi rapi, lengan kiri putus, kulit hitam kelam',
        danger: 'EXTREME',
        image: 'https://lh3.googleusercontent.com/d/1yA0p19G29JqH36Bf-N-J3R2XwJ3dK6W_',
        description: 'RAWNG adalah entitas humanoid berukuran 215 cm yang dilaporkan menghuni kawasan pegunungan Gunma. Makhluk ini memiliki kepala bulat, kulit hitam kelam, serta mulut lebar berisi 48 gigi yang selalu tampak tersenyum. Salah satu ciri uniknya adalah lengan kirinya yang terputus tanpa alasan jelas. Dikenal memangsa domba, babi ternak, hingga babi hutan.'
      },
      {
        id: 'haruna-phantom',
        name: 'The Whistling Phantom of Haruna',
        category: 'Urban Legend',
        habitat: 'Danau & Gunung Haruna',
        stats: 'Tinggi: Tak Menentu | Suara: 120 dB',
        traits: 'Jubah lusuh, siulan bernada minor, mata menyala kuning',
        danger: 'HIGH',
        image: 'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=600&auto=format&fit=crop&q=80',
        description: 'Bayangan misterius berdengung yang muncul di sekitar Danau Haruna pada malam berkabut. Menurut kesaksian pendaki, muncul suara siulan melengking sebelum korban merasakan disorientasi total dan tersesat di dalam hutan.'
      },
      {
        id: 'swamp-weaver',
        name: 'Penjalin Rawa Akagi',
        category: 'Monster',
        habitat: 'Rawa Lemba Akagi',
        stats: 'Panjang: 400 cm | Berat: ~300 kg',
        traits: 'Tubuh mirip laba-laba bertangan manusia, sarat benang hitam',
        danger: 'MODERATE',
        image: 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=600&auto=format&fit=crop&q=80',
        description: 'Makhluk nokturnal berkaki banyak yang menjerat mangsanya menggunakan benang lengket berwarna gelap. Memburu hewan liar dan penjelajah yang melanggar batas rawa di malam hari.'
      }
    ];

    let creatures = [];

    // Initialize App & LocalStorage
    window.onload = function() {
      // Set Copyright Year
      document.getElementById('yearSpan').textContent = new Date().getFullYear();

      // Load saved creatures or fallback
      const saved = localStorage.getItem('author_cryptid_database');
      if (saved) {
        try {
          creatures = JSON.parse(saved);
        } catch (e) {
          creatures = initialCreatures;
        }
      } else {
        creatures = initialCreatures;
        saveToLocalStorage();
      }

      renderCatalog(creatures);
      updateStats();
      initFogCanvas();
    };

    function saveToLocalStorage() {
      localStorage.setItem('author_cryptid_database', JSON.stringify(creatures));
    }

    function updateStats() {
      document.getElementById('statCryptids').textContent = creatures.length;
      document.getElementById('statWorks').textContent = creatures.length + 8;
    }

    // Render Cards in Catalog Grid
    function renderCatalog(items) {
      const grid = document.getElementById('creaturesGrid');
      const countLabel = document.getElementById('displayedCount');
      grid.innerHTML = '';
      countLabel.textContent = items.length;

      if (items.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full text-center py-12 text-gray-500 font-mono">
            <i class="fa-solid fa-box-open text-3xl mb-2 block"></i>
            Tidak ada berkas spesimen yang cocok dengan pencarian Anda.
          </div>
        `;
        return;
      }

      items.forEach(c => {
        const card = document.createElement('div');
        card.className = 'bg-cardbg border border-gray-800 rounded-xl overflow-hidden hover:border-red-600/60 transition duration-300 flex flex-col justify-between group red-glow-hover';

        const dangerBg = c.danger === 'EXTREME' ? 'bg-red-950 text-red-400 border-red-700' :
                         c.danger === 'HIGH' ? 'bg-amber-950 text-amber-400 border-amber-700' :
                         'bg-blue-950 text-blue-400 border-blue-700';

        const imgUrl = c.image || 'https://placehold.co/600x400/111622/ef4444?text=' + encodeURIComponent(c.name);

        card.innerHTML = `
          <div>
            <!-- Card Image Box -->
            <div class="relative h-48 overflow-hidden bg-black">
              <img src="${imgUrl}" alt="${c.name}" 
                   onerror="this.onerror=null; this.src='https://placehold.co/600x400/111622/ef4444?text=IMAGE+NOT+FOUND';"
                   class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
              <div class="absolute top-3 left-3 px-2 py-0.5 rounded font-mono text-[10px] border ${dangerBg}">
                BAHAYA: ${c.danger || 'UNKNOWN'}
              </div>
              <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-black/80 font-mono text-[10px] text-gray-300">
                ${c.category}
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-5 space-y-3">
              <h3 class="font-cinzel text-xl font-bold text-white group-hover:text-red-400 transition">${c.name}</h3>
              <p class="font-mono text-xs text-gray-400 flex items-center gap-1">
                <i class="fa-solid fa-location-dot text-red-500"></i> ${c.habitat}
              </p>
              <p class="text-xs text-gray-300 line-clamp-3 font-sans leading-relaxed">
                ${c.description}
              </p>
            </div>
          </div>

          <!-- Card Footer Button -->
          <div class="px-5 pb-5 pt-2">
            <button onclick="openDetailModal('${c.id}')" class="w-full py-2 bg-darkvoid hover:bg-blood-600 text-gray-300 hover:text-white font-mono text-xs rounded border border-gray-700 hover:border-red-500 flex items-center justify-center gap-2 transition">
              <i class="fa-solid fa-folder-open"></i> Buka Berkas Lengkap
            </button>
          </div>
        `;

        grid.appendChild(card);
      });
    }

    // Filter & Search Logic
    function filterCatalog() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const cat = document.getElementById('categoryFilter').value;

      const filtered = creatures.filter(c => {
        const matchesQuery = c.name.toLowerCase().includes(query) ||
                             c.habitat.toLowerCase().includes(query) ||
                             c.description.toLowerCase().includes(query);
        const matchesCat = (cat === 'ALL') || (c.category === cat);
        return matchesQuery && matchesCat;
      });

      renderCatalog(filtered);
    }

    // Modal Control: Detail Modal
    function openDetailModal(id) {
      const creature = creatures.find(c => c.id === id);
      if (!creature) return;

      document.getElementById('modalTitle').textContent = creature.name;
      document.getElementById('modalCategory').textContent = creature.category.toUpperCase();
      document.getElementById('modalSubtitle').textContent = 'Habitat / Asal: ' + creature.habitat;
      document.getElementById('modalStats').textContent = creature.stats;
      document.getElementById('modalDanger').textContent = creature.danger;
      document.getElementById('modalTraits').textContent = creature.traits || '-';
      document.getElementById('modalDescription').textContent = creature.description;

      const imgUrl = creature.image || 'https://placehold.co/600x400/111622/ef4444?text=' + encodeURIComponent(creature.name);
      document.getElementById('modalImage').src = imgUrl;

      const modal = document.getElementById('detailModal');
      modal.classList.remove('hidden');
      setTimeout(() => modal.classList.remove('opacity-0'), 10);
    }

    function closeDetailModal() {
      const modal = document.getElementById('detailModal');
      modal.classList.add('opacity-0');
      setTimeout(() => modal.classList.add('hidden'), 300);
    }

    // Modal Control: Add Monster Modal
    function openAddModal() {
      const modal = document.getElementById('addModal');
      modal.classList.remove('hidden');
      setTimeout(() => modal.classList.remove('opacity-0'), 10);
    }

    function closeAddModal() {
      const modal = document.getElementById('addModal');
      modal.classList.add('opacity-0');
      setTimeout(() => modal.classList.add('hidden'), 300);
    }

    // Handle Adding New Monster Dynamic Form
    function handleFormSubmit(e) {
      e.preventDefault();

      const newCreature = {
        id: 'custom-' + Date.now(),
        name: document.getElementById('inputName').value,
        category: document.getElementById('inputCategory').value,
        danger: document.getElementById('inputDanger').value,
        habitat: document.getElementById('inputHabitat').value,
        stats: document.getElementById('inputStats').value,
        traits: document.getElementById('inputTraits').value || 'Tidak Ada Data',
        image: document.getElementById('inputImage').value,
        description: document.getElementById('inputDescription').value
      };

      creatures.unshift(newCreature);
      saveToLocalStorage();
      renderCatalog(creatures);
      updateStats();

      document.getElementById('addMonsterForm').reset();
      closeAddModal();
    }

    // Ambient Audio Simulation Logic
    let isAudioPlaying = false;
    let audioCtx = null;
    let oscillator = null;

    function toggleAmbientSound() {
      const btnIcon = document.getElementById('soundIcon');
      const btnText = document.getElementById('soundText');

      if (!isAudioPlaying) {
        // Start Low Drone Sound synth
        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioContext();
          oscillator = audioCtx.createOscillator();
          const gainNode = audioCtx.createGain();

          oscillator.type = 'sawtooth';
          oscillator.frequency.setValueAtTime(55, audioCtx.currentTime); // Low A drone note
          gainNode.gain.setValueAtTime(0.04, audioCtx.currentTime); // Subtle volume

          oscillator.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          oscillator.start();

          isAudioPlaying = true;
          btnIcon.className = 'fa-solid fa-volume-high text-red-500';
          btnText.textContent = 'Audio: ON';
        } catch (e) {
          console.log('Audio disabled or not supported');
        }
      } else {
        if (oscillator) oscillator.stop();
        if (audioCtx) audioCtx.close();
        isAudioPlaying = false;
        btnIcon.className = 'fa-solid fa-volume-xmark text-gray-500';
        btnText.textContent = 'Audio: OFF';
      }
    }

    // Fog Animation Canvas Logic
    function initFogCanvas() {
      const canvas = document.getElementById('fogCanvas');
      const ctx = canvas.getContext('2d');

      function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      const particles = [];
      for (let i = 0; i < 25; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          radius: Math.random() * 150 + 100,
          opacity: Math.random() * 0.05 + 0.02,
          speedX: Math.random() * 0.4 - 0.2,
          speedY: Math.random() * 0.2 - 0.1
        });
      }

      function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        particles.forEach(p => {
          p.x += p.speedX;
          p.y += p.speedY;

          if (p.x < -p.radius) p.x = canvas.width + p.radius;
          if (p.x > canvas.width + p.radius) p.x = -p.radius;
          if (p.y < -p.radius) p.y = canvas.height + p.radius;
          if (p.y > canvas.height + p.radius) p.y = -p.radius;

          const gradient = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius);
          gradient.addColorStop(0, `rgba(139, 0, 0, ${p.opacity})`);
          gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');

          ctx.fillStyle = gradient;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fill();
        });

        requestAnimationFrame(animate);
      }
      animate();
    }
  </script>
</body>
